# Copy to .env and fill in. .env is ignored by git; never commit real keys.
# Your model provider key. The variable name depends on -provider (OPENAI_API_KEY, OPENROUTER_API_KEY, DEEPSEEK_API_KEY, ...).
OPENROUTER_API_KEY=
# The key your agent sends as its API key. Make one with: openssl rand -hex 24
RAKUVO_TOKEN=
